# Скопируйте в .env и заполните. .env не коммитится.

# Полный URL GET из гайда организаторов (кнопка «Открыть GET для DEV»).
# group_id подставляет приложение (DEV сейчас, контрольный — через 23 часа).
ORGANIZER_API_URL=
DATASET_GROUP_ID=DEV

# Какой провайдер LLM использовать по умолчанию: openrouter | gemini | ollama
LLM_PROVIDER=openrouter

# OpenRouter (платный, основной для eval и финала)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# id модели из https://openrouter.ai/models, например vendor/model-name
OPENROUTER_MODEL=

# Gemini (бесплатный ключ Google AI Studio, черновые прогоны; реальные звонки не отправлять)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=

# Ollama (локально, опционально)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

DATABASE_URL=sqlite:///./data/cqa.db
