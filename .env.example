# Скопируйте в .env и заполните. .env не коммитится.

# Полный URL GET из гайда организаторов (кнопка «Открыть GET для DEV»), БЕЗ параметра group_id.
# group_id подставляет приложение (DEV сейчас, контрольный — через 23 часа).
ORGANIZER_API_URL=
DATASET_GROUP_ID=DEV

# Облачная модель (Claude API)
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-opus-5-5
CLOUD_EFFORT=high

# Локальная модель (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen3:8b

# Какой провайдер использовать по умолчанию: cloud | local
LLM_PROVIDER=cloud

DATABASE_URL=sqlite:///./data/cqa.db
